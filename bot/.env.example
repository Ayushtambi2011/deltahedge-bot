# Copy to .env and fill in. NEVER commit .env.
# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_@BotFather
TELEGRAM_CHAT_ID=your_numeric_chat_id

# Delta Exchange India API (read-only keys are enough — this bot never trades)
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_API_KEY=your_read_only_key
DELTA_API_SECRET=your_read_only_secret

# Liquidation data (OPTIONAL — Coinglass heatmap is a PAID Pro feature; no free API)
# Leave blank to use manual data/liquidation_levels.csv instead.
COINGLASS_API_KEY=

# Behaviour
SYMBOLS=BTC,ETH
DRY_RUN=true      # true = print to console only; set false to actually send Telegram
